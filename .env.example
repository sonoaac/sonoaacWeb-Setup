# Environment Configuration Example
# Copy this file to .env and update values as needed

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=localhost

# Database — DISABLED. The app runs DB-less with stub data (see server/db.ts).
# Leave this unset. Only restore it if you re-enable the Pool in server/db.ts.
# DATABASE_URL=postgresql://user:password@localhost:5432/sonoaacdb

# Session Configuration
SESSION_SECRET=your-secret-key-change-this

# API Configuration
API_BASE_URL=http://localhost:5000

# ── Free Email via Gmail (replaces SendGrid) ─────────────────────────────────
# 1. Enable 2-Step Verification on your Google account (myaccount.google.com)
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Select "Mail" as app, generate — copy the 16-char password below
GMAIL_USER=sonoaac@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Free SMS alerts via Tello/T-Mobile carrier gateway ───────────────────────
# Format: your10digitnumber@tmomail.net  (Tello uses T-Mobile network)
# Example: 9175550100@tmomail.net
# Other carriers: @txt.att.net (AT&T), @vtext.com (Verizon), @sms.cricketwireless.net (Cricket)
ADMIN_PHONE_SMS=9175550100@tmomail.net

# ── Ticket Tracking Portal ───────────────────────────────────────────────────
# Set this to a strong random string — it's your admin login key for /admin/tickets
ADMIN_KEY=change-this-to-something-secret-and-long

# Your public site URL — used to generate customer track links
SITE_URL=https://sonoaac.com

# ── Optional / Legacy ────────────────────────────────────────────────────────
# SENDGRID_API_KEY=SG...   ← no longer used, replaced by Gmail above
# STRIPE_SECRET_KEY=sk_test_...
# OPENAI_API_KEY=sk-...

# Feature Flags
ENABLE_QUOTES=true
ENABLE_PC_BUILDER=true
ENABLE_SERVICES=true
